# Copier ce fichier en .env.local et renseigner les valeurs réelles.
# .env.local n'est jamais commité (voir .gitignore).

# Connexion MongoDB
MONGODB_URI=

# NextAuth (Auth.js) — secret de session, générer avec `openssl rand -base64 32`
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# IA — clé API Gemini (tier gratuit), https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Compte administrateur (utilisé uniquement par scripts/seed-admin.ts, pas
# lu par l'application elle-même) :
# ADMIN_EMAIL=admin@exemple.com
# ADMIN_PASSWORD=

# Optionnel — envoi d'emails réel (mot de passe oublié). Sans ces variables,
# les emails sont simplement journalisés côté serveur (voir lib/email).
# RESEND_API_KEY=
# EMAIL_FROM="BudGest <no-reply@votredomaine.com>"
